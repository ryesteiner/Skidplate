-d always,exit -F arch=b64 -S execve,execveat -F path=/usr/bin/chmod -F perm=x -k sentinel_sigma_exec
-d always,exit -F arch=b32 -S execve,execveat -F path=/usr/bin/chattr -F perm=x -k sentinel_sigma_exec
-d always,exit -F arch=b64 -S execve,execveat -F path=/usr/bin/chattr -F perm=x -k sentinel_sigma_exec
-d always,exit -F arch=b32 -S execve,execveat -F path=/usr/bin/nft -F perm=x -k sentinel_sigma_exec
-d always,exit -F arch=b64 -S execve,execveat -F path=/usr/bin/nft -F perm=x -k sentinel_sigma_exec
-d always,exit -F arch=b32 -S execve,execveat -F path=/usr/bin/ufw -F perm=x -k sentinel_sigma_exec
-d always,exit -F arch=b64 -S execve,execveat -F path=/usr/bin/ufw -F perm=x -k sentinel_sigma_exec
-d always,exit -F arch=b32 -S execve,execveat -F path=/usr/bin/sysctl -F perm=x -k sentinel_sigma_exec
-d always,exit -F arch=b64 -S execve,execveat -F path=/usr/bin/sysctl -F perm=x -k sentinel_sigma_exec
-d always,exit -F arch=b32 -S execve,execveat -F path=/usr/bin/ftp -F perm=x -k susp_activity
