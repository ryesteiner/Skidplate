-d always,exit -F arch=b32 -S execve,execveat -F path=/usr/bin/sftp -F perm=x -k susp_activity
-d always,exit -F arch=b64 -S execve,execveat -F path=/usr/bin/sftp -F perm=x -k susp_activity
