-A always,exit -F arch=b32 -S execve,execveat -F path=/usr/bin/sftp -F perm=x -k susp_activity
-A always,exit -F arch=b64 -S execve,execveat -F path=/usr/bin/ftp -F perm=x -k susp_activity
-A always,exit -F arch=b32 -S execve,execveat -F path=/usr/bin/ftp -F perm=x -k susp_activity
