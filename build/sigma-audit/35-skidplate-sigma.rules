# DRAFT ONLY: read docs/SIGMA-ARGUMENTS.md before activation.
# No reset, suppression, immutable, backlog, failure or rate changes.
# Adds raw argv to root-owned audit logs; Skidplate saves no argv.
# Not a guarantee of collection: ordering, existing watches and losses matter.
# Skipped absent/symlink executables: /usr/bin/wget, /usr/bin/nc, /usr/bin/netcat, /usr/bin/ncat, /usr/bin/netstat, /usr/bin/socat, /usr/bin/wireshark, /usr/bin/tshark, /usr/bin/rawshark, /usr/bin/rdesktop, /usr/bin/wlfreerdp, /usr/bin/xfreerdp, /usr/bin/nmap, /usr/bin/iptables, /usr/bin/ip6tables, /usr/bin/firewall-cmd, /usr/bin/xmrig
-A always,exit -F arch=b64 -S execve,execveat -F path=/usr/bin/curl -F perm=x -k susp_activity
-A always,exit -F arch=b32 -S execve,execveat -F path=/usr/bin/curl -F perm=x -k susp_activity
-A always,exit -F arch=b64 -S execve,execveat -F path=/usr/bin/base64 -F perm=x -k susp_activity
-A always,exit -F arch=b32 -S execve,execveat -F path=/usr/bin/base64 -F perm=x -k susp_activity
-A always,exit -F arch=b64 -S execve,execveat -F path=/usr/bin/ss -F perm=x -k susp_activity
-A always,exit -F arch=b32 -S execve,execveat -F path=/usr/bin/ss -F perm=x -k susp_activity
-A always,exit -F arch=b64 -S execve,execveat -F path=/usr/bin/ssh -F perm=x -k susp_activity
-A always,exit -F arch=b32 -S execve,execveat -F path=/usr/bin/ssh -F perm=x -k susp_activity
